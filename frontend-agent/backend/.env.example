# Variables de entorno para el backend PHP de Mindora Care

# Configuración de la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindora_care
DB_USER=root
DB_PASSWORD=

# URL base del backend Java (para integración con la IA)
JAVA_API_BASE_URL=http://localhost:8080

# Origen permitido para CORS (frontend React)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Configuración de la sesión (para PHP nativo)
SESSION_NAME=MINDI_SESSION
SESSION_LIFETIME=3600 # Segundos
